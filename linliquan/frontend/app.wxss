page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-primary:active {
  background: #06ad56;
}

.btn-disabled {
  background: #ccc;
  color: #999;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.form-input:focus {
  border-color: #07c160;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-danger {
  color: #ff4d4f;
}

.text-success {
  color: #07c160;
}
