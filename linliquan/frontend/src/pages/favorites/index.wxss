/* pages/favorites/index.wxss */
/* 我的收藏页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 帖子列表 */
.post-list {
  padding: 20rpx 0;
}

/* 单条容器：承载卡片与删除按钮 */
.post-item-wrapper {
  position: relative;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 帖子卡片 */
.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease;
  position: relative;
  z-index: 2;
}

/* 标题 */
.post-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
  /* 单行省略 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 内容摘要 */
.post-summary {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  /* 最多两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 底部信息栏 */
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
  color: #666;
  font-size: 24rpx;
}

.stat-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.stat-text {
  font-size: 24rpx;
}

/* 删除按钮：默认隐藏在卡片右侧 */
.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 160rpx;
  height: 100%;
  background: #fa5151;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  z-index: 1;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
