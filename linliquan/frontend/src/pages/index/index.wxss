/* pages/index/index.wxss */
/* 信息广场页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 认证引导条 */
.auth-banner {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  padding: 20rpx 30rpx;
}

.auth-banner-content {
  display: flex;
  align-items: center;
  color: #fff;
}

.auth-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.auth-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.4;
}

.auth-action {
  font-size: 26rpx;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #333;
  color: #fff;
  font-size: 24rpx;
}

.status-text {
  color: #07c160;
  font-weight: bold;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 0;
  position: relative;
}

.tab-item.active {
  color: #07c160;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #07c160;
  border-radius: 2rpx;
}

.post-list {
  height: calc(100vh - 200rpx);
}

.post-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.post-header {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.distance-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8f0;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.post-content {
  margin-top: 20rpx;
}

.post-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.post-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.post-images image {
  width: 200rpx;
  height: 200rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
}

.post-actions {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  color: #666;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.action-item.liked {
  color: #fa5151;
}

.action-item .icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
}

/* 悬浮发布按钮 */
.publish-btn-wrapper {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  z-index: 100;
}

.publish-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  position: relative;
}

.publish-btn.enabled {
  background: #07c160;
}

.publish-btn.disabled {
  background: #ccc;
}

.publish-btn .icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: 300;
}

/* PENDING状态：审核中角标 */
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #f5a623;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
