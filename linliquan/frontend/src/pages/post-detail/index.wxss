/* pages/post-detail/index.wxss */
/* 帖子详情页样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.scroll-content {
  height: 100vh;
}

.post-detail {
  background: #fff;
  padding: 30rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.distance-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8f0;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.post-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
}

.post-images {
  margin-top: 24rpx;
}

.post-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.post-stats {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #999;
}

/* 评论区 */
.comment-section-title {
  background: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.title-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.comment-list {
  background: #fff;
}

.comment-item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  display: block;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.comment-like {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  color: #999;
  font-size: 22rpx;
}

.comment-like.liked {
  color: #fa5151;
}

.comment-like text {
  margin-right: 4rpx;
}

.reply-btn {
  font-size: 22rpx;
  color: #666;
}

.empty-comments {
  padding: 80rpx 30rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

.loading-more,
.loading-page {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
}

.bottom-placeholder {
  height: 120rpx;
}

/* 底部评论输入框 */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333;
}

.send-btn {
  margin-left: 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  background: #ccc;
  color: #fff;
  border-radius: 32rpx;
  border: none;
}

.send-btn.active {
  background: #07c160;
}

.send-btn[disabled] {
  background: #ccc;
  color: #fff;
}
