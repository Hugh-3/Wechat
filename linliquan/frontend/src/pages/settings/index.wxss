/* pages/settings/index.wxss */
/* 设置页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* 菜单区域 */
.menu-section {
  margin: 20rpx 30rpx;
}

.menu-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}

.menu-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-status {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}

/* 当前环境标签 */
.menu-status.env-tag {
  color: #07c160;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 消息通知开关 */
.menu-switch {
  transform: scale(0.85);
}

/* 退出登录按钮 */
.logout-section {
  margin: 40rpx 30rpx 0;
}

.logout-btn {
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #fa5151;
  font-weight: 500;
}

/* 底部版本信息 */
.footer-text {
  text-align: center;
  margin-top: 50rpx;
  font-size: 22rpx;
  color: #ccc;
}
