<view class="container">
  <view class="step-bar">
    <view class="step-item {{step === 1 ? 'active' : 'done'}}">
      <view class="step-dot">1</view>
      <text class="step-text">手机号</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step-item {{step === 2 ? 'active' : ''}}">
      <view class="step-dot">2</view>
      <text class="step-text">认证信息</text>
    </view>
  </view>

  <view class="form-section" wx:if="{{step === 1}}">
    <view class="section-title">
      <text class="icon">🔒</text>
      <text>为了保护您和邻居的安全</text>
    </view>
    <view class="section-desc">只有认证业主才能发布动态、联系邻居</view>

    <view class="form-item">
      <text class="form-label">手机号码</text>
      <input 
        class="form-input" 
        placeholder="请输入您的手机号" 
        type="number" 
        maxlength="11"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="agreement">
      <text class="text-muted">
        提交即表示您同意《隐私政策》和《服务条款》，您的证件信息将加密存储
      </text>
    </view>

    <button 
      class="btn-primary {{phone.length === 11 ? '' : 'btn-disabled'}}"
      bindtap="goToStep2"
      disabled="{{phone.length !== 11}}"
    >
      下一步
    </button>
  </view>

  <view class="form-section" wx:if="{{step === 2}}">
    <view class="section-title">
      <text class="icon">📋</text>
      <text>填写认证信息</text>
    </view>

    <view class="form-item">
      <text class="form-label">身份证号</text>
      <input 
        class="form-input" 
        placeholder="请输入身份证号" 
        type="number" 
        maxlength="18"
        value="{{idCard}}"
        bindinput="onIdCardInput"
      />
      <text class="text-muted">用于身份验证，信息将加密存储</text>
    </view>

    <view class="form-item">
      <text class="form-label">房号</text>
      <input 
        class="form-input" 
        placeholder="例如：3栋2单元1001" 
        value="{{houseNumber}}"
        bindinput="onHouseNumberInput"
      />
      <text class="text-muted">用于验证您的业主身份</text>
    </view>

    <view class="tips">
      <view class="tip-item">
        <text class="tip-icon">🔒</text>
        <text>您的证件信息将加密存储</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">📋</text>
        <text>审核通过后7天自动删除原图</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">✅</text>
        <text>认证通过即可发布/互动</text>
      </view>
    </view>

    <button 
      class="btn-primary"
      bindtap="submitVerification"
      loading="{{submitting}}"
    >
      提交审核
    </button>

    <button class="btn-secondary" bindtap="goBack">
      返回
    </button>
  </view>
</view>
