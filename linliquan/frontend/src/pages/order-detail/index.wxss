/* pages/order-detail/index.wxss */
/* 订单详情页样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.scroll-content {
  height: 100vh;
}

.loading-page {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 订单头部 */
.order-header {
  background: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-type-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #e8f8f0;
  color: #07c160;
}

.order-type-badge.type-2 { background: #fff3e0; color: #ff9800; }
.order-type-badge.type-3 { background: #e3f2fd; color: #2196f3; }
.order-type-badge.type-4 { background: #f3e5f5; color: #9c27b0; }

.status-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.status-badge.status-1 {
  background: #fff3e0;
  color: #ff9800;
}

.status-badge.status-2 {
  background: #e3f2fd;
  color: #2196f3;
}

.status-badge.status-3 {
  background: #e8f8f0;
  color: #07c160;
}

/* 订单主体 */
.order-main {
  background: #fff;
  padding: 30rpx;
  padding-top: 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  display: block;
  margin-bottom: 24rpx;
}

.reward-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.reward-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
}

.reward-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.distance-section {
  display: flex;
  align-items: center;
}

.distance-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.distance-text {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 500;
}

/* 发布者信息 */
.publisher-section {
  background: #fff;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.publisher-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.publisher-info {
  flex: 1;
}

.publisher-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.publish-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 订单内容 */
.order-content-section {
  background: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.order-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
}

.order-images {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.order-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.bottom-placeholder {
  height: 140rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.action-left {
  flex: 1;
  margin-right: 20rpx;
}

.contact-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #333;
  border-radius: 40rpx;
  border: none;
}

.contact-btn.disabled {
  color: #999;
}

.action-right {
  flex: 1;
}

.action-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  border-radius: 40rpx;
  border: none;
}

.action-btn.accept {
  background: #07c160;
}

.action-btn.complete {
  background: #ff9800;
}

.action-btn.done {
  background: #ccc;
  color: #fff;
}

.action-btn[disabled] {
  background: #ccc;
  color: #fff;
}
