.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.type-switch {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.type-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  padding: 20rpx 0;
  position: relative;
}

.type-item.active {
  color: #07c160;
  font-weight: bold;
}

.type-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #07c160;
  border-radius: 2rpx;
}

.form-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
}

.form-textarea {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
  height: 200rpx;
}

.word-count {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

.type-options {
  display: flex;
  flex-wrap: wrap;
}

.type-option {
  padding: 16rpx 32rpx;
  background: #f8f8f8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 16rpx;
}

.type-option.active {
  background: #e8f8f0;
  color: #07c160;
}

.price-input {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.price-symbol {
  font-size: 32rpx;
  color: #333;
}

.price-input .form-input.price {
  background: transparent;
  border: none;
  padding: 24rpx;
  flex: 1;
}

.price-hint {
  font-size: 22rpx;
  color: #999;
}

.image-upload {
  display: flex;
  flex-wrap: wrap;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.upload-icon {
  font-size: 60rpx;
  color: #ccc;
}

.uploaded-image {
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.uploaded-image image {
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.location-info {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #e8f8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #07c160;
}

.location-icon {
  margin-right: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.btn-submit {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: bold;
}
