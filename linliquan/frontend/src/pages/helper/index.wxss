/* pages/helper/index.wxss */
/* 邻里互助页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #333;
  color: #fff;
  font-size: 24rpx;
}

.status-text {
  color: #07c160;
  font-weight: bold;
}

.location-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.location-text {
  font-size: 26rpx;
  color: #333;
}

.refresh-btn {
  font-size: 24rpx;
  color: #07c160;
}

.type-bar {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.type-item {
  display: inline-block;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-left: 20rpx;
}

.type-item.active {
  background: #07c160;
  color: #fff;
  border-radius: 30rpx;
}

.order-list {
  height: calc(100vh - 300rpx);
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.order-type {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #e8f8f0;
  color: #07c160;
}

.order-type.type-2 { background: #fff3e0; color: #ff9800; }
.order-type.type-3 { background: #e3f2fd; color: #2196f3; }
.order-type.type-4 { background: #f3e5f5; color: #9c27b0; }

.order-content {
  margin-bottom: 20rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.order-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.order-user {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.user-name {
  font-size: 24rpx;
  color: #666;
}

.order-footer {
  display: flex;
  align-items: center;
}

.distance {
  flex: 1;
  font-size: 26rpx;
  color: #07c160;
  font-weight: bold;
}

.reward {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-right: 20rpx;
}

.contact-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.contact-btn.enabled {
  background: #07c160;
  color: #fff;
}

.contact-btn.disabled {
  background: #f0f0f0;
  color: #999;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  margin-top: 16rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
