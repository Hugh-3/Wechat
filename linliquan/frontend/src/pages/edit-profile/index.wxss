/* pages/edit-profile/index.wxss */
/* 资料编辑页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #f0f0f0;
}

.avatar {
  width: 100%;
  height: 100%;
  display: block;
}

/* 相机图标覆盖在头像右下角 */
.camera-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(7, 193, 96, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
}

.camera-icon {
  font-size: 24rpx;
  color: #fff;
}

.avatar-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* 昵称输入卡片 */
.form-card {
  margin: 0 30rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.form-label {
  width: 120rpx;
  font-size: 30rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 保存按钮 */
.btn-wrapper {
  padding: 0 30rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  border: none;
}

.save-btn.disabled {
  background: #9ed8b6;
}

/* 底部安全区域 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  height: constant(safe-area-inset-bottom);
}
