<!-- pages/edit-profile/index.wxml -->
<!-- 资料编辑页面 -->

<view class="container">
  <!-- 头像区域 -->
  <view class="avatar-section" bindtap="onChooseAvatar">
    <view class="avatar-wrapper">
      <image class="avatar" src="{{avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill" />
      <view class="camera-mask">
        <text class="camera-icon">📷</text>
      </view>
    </view>
    <text class="avatar-tip">点击修改头像</text>
  </view>

  <!-- 昵称输入卡片 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        type="text"
        value="{{nickname}}"
        placeholder="请输入昵称"
        maxlength="20"
        bindinput="onNicknameInput" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="btn-wrapper">
    <button
      class="save-btn {{submitting ? 'disabled' : ''}}"
      bindtap="onSave"
      disabled="{{submitting}}">
      {{submitting ? '保存中...' : '保存'}}
    </button>
  </view>

  <!-- 底部安全区域留白 -->
  <view class="safe-bottom"></view>
</view>
