/* pages/points/index.wxss */
/* 积分中心页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部积分展示 */
.points-header {
  background: linear-gradient(135deg, #ff9500 0%, #ff7a00 100%);
  padding: 60rpx 30rpx 50rpx;
}

.points-balance-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.points-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 16rpx;
}

.points-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.1;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff7a00;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #ff7a00;
  border-radius: 3rpx;
}

/* 内容区 */
.content-section {
  padding: 20rpx 30rpx;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ==================== 积分明细 ==================== */

.txn-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.txn-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.txn-item:last-child {
  border-bottom: none;
}

.txn-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.txn-action {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.txn-time {
  font-size: 22rpx;
  color: #bbb;
}

.txn-remark {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.txn-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.txn-points {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.txn-points.earn {
  color: #ff7a00;
}

.txn-points.spend {
  color: #07c160;
}

.txn-balance {
  font-size: 22rpx;
  color: #bbb;
}

/* ==================== 积分商城 ==================== */

.items-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.item-card {
  width: 335rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-image {
  width: 100%;
  height: 220rpx;
  background: #f0f0f0;
}

.item-info {
  padding: 20rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-points {
  font-size: 26rpx;
  color: #ff7a00;
  font-weight: bold;
}

.item-stock {
  font-size: 20rpx;
  color: #bbb;
}

.exchange-btn {
  width: 100% !important;
  height: 70rpx;
  line-height: 70rpx;
  background: #ff7a00 !important;
  color: #fff !important;
  font-size: 26rpx;
  border-radius: 0 !important;
  border: none;
}

.exchange-btn.disabled {
  background: #ccc !important;
  color: #fff !important;
}

.exchange-btn::after {
  border: none;
}

/* ==================== 兑换记录 ==================== */

.record-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-right: 20rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 22rpx;
  color: #bbb;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-cost {
  font-size: 26rpx;
  color: #07c160;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.record-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.record-status.pending {
  color: #f5a623;
  background: #fff7e6;
}

.record-status.done {
  color: #07c160;
  background: #e8f8f0;
}

.record-status.cancelled {
  color: #999;
  background: #f5f5f5;
}

/* ==================== 加载更多 ==================== */

.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #bbb;
  font-size: 24rpx;
}

.load-more-btn {
  text-align: center;
  padding: 24rpx 0;
  color: #ff7a00;
  font-size: 26rpx;
}
